__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Svelte review workspace build and browser-test output
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/

# Pipeline artifacts (per-episode sidecars/stamps written into the media tree, never
# meant to be committed to this repo -- see specs/v2-models-ops/spec.md, Phase B).
*.eng.dubtitles.srt
*.eng.dubtitles.ass
*.dubtitles.conf.json
*.dubtitles.done
*.dubtitles.fail
*.dubtitles.repair.csv
*.dubtitles.mux.log
*.muxtmp.mkv
glossaries/*.lastrun.json

# Resumable glossary stages (adjudication_journal.py): acquire writes <glossary>.acquire.journal.jsonl beside each tracked glossary,
# verify writes <show>.verify.journal.jsonl under the wiki cache dir; each has a .lock and a compaction temp file. Local run state.
*.journal.jsonl
*.journal.jsonl.lock
*.journal.jsonl.*.tmp

# procoder: generated artifacts. config.toml and ask/ are the tracked standard;
# the code index and session state are rebuilt on demand and never belong in a commit.
.procoder/index/
.procoder/state/

# agent-harness scratch worktrees (created under the repo root, never meant to ship)
.claude/worktrees/

# skill-tooling lockfile scaffold, regenerated locally, not a project artifact
skills-lock.json

# ASR bakeoff: raw harness output carries full transcripts of commercial dubs.
# Only the stripped, metrics-only reports belong in the tree (docs/asr-bakeoff/README.md).
docs/asr-bakeoff/*-report.json

# procoder maintainer complexity-baseline snapshot: regenerated per run, host-local,
# never a project artifact.
.craftsman-baseline.json

# lychee (markdown link checker) cache -- regenerated per run, host-local.
.lycheecache
