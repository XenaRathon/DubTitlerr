# Example environment for `docker compose up`. Copy to `.env` and edit.
# Full variable reference: https://github.com/xenarathon/DubTitlerr/wiki/Reference

# --- Image tag ---------------------------------------------------------------

# `latest` tracks the most recent release, never `main`. Beta status: pin a
# release tag instead (e.g. v0.1.0-beta) for reproducible version stamps.
DUBTITLERR_TAG=latest

# --- Host paths ---------------------------------------------------------------

# Your anime library, mounted read/write (the mux stage rewrites episodes in place).
MEDIA_ROOT=/path/to/your/media

# Persistent state: glossaries, decisions, wiki cache, anime_order.txt, review token.
CONFIG_ROOT=./dubtitlerr-config

# --- Required in-container path ----------------------------------------------

# Root of your anime library INSIDE the container (after the /media mount),
# e.g. "/media/Anime Library". This is a container path, not a host path.
ANIME_ROOT=/media/Anime Library

# --- Transcription --------------------------------------------------------

# Must match the model baked into the image if you build locally with
# --build-arg WHISPER_MODEL=large-v3.
WHISPER_MODEL=large-v3-turbo

# --- Ownership of what it writes ----------------------------------------

MEDIA_UID=1000
MEDIA_GID=100

# --- Plex refresh (optional — blank skips it) ----------------------------

PLEX_URL=
PLEX_TOKEN=
PLEX_SECTION=

# --- Repair-review web UI auth --------------------------------------------
#
# Leave REVIEW_TOKEN unset (blank here) to auto-generate one at startup
# (printed to the log once, also readable at $CONFIG_ROOT/review_token). Set
# to a non-empty value to pin it. An empty value no longer disables auth --
# set REVIEW_AUTH=off instead, and only on a network you fully trust. See
# SECURITY.md.
REVIEW_TOKEN=
REVIEW_AUTH=
